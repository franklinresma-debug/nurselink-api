APP_NAME="NurseLink API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.amsertech.com
FRONTEND_URL=https://app.amsertech.com
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=frankresma_nurselink
DB_USERNAME=frankresma_nurselink
DB_PASSWORD=REPLACE_WITH_CPANEL_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.amsertech.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=app.amsertech.com
CORS_ALLOWED_ORIGINS=https://app.amsertech.com

FILESYSTEM_DISK=local
NURSELINK_PRIVATE_DISK=private
NURSELINK_PRIVATE_DRIVER=local
NURSELINK_MAX_DOCUMENT_MB=15
NURSELINK_DOCUMENT_EXTRACTOR=local_ocr
NURSELINK_OCR_QUEUE_ENABLED=true
NURSELINK_OCR_QUEUE=document-extraction
NURSELINK_OCR_MAX_PDF_PAGES=5
NURSELINK_OCR_PROCESS_TIMEOUT=45
NURSELINK_OCR_IDLE_TIMEOUT=20
NURSELINK_OCR_LANGUAGE=eng

# Shared cPanel has no resident ClamAV service exposed to this app by default.
# Keep disabled until a scanner/manual officer-review process is connected.
# Uploaded evidence remains pending and cannot be treated as security-cleared.
NURSELINK_MALWARE_SCANNER=clamav
# Ubuntu clamav-daemon normally exposes this Unix socket. Leave blank when using TCP.
CLAMAV_SOCKET=/run/clamav/clamd.ctl
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@amsertech.com
MAIL_FROM_NAME="NurseLink"

AUDIT_IP_HASH_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

NURSELINK_EMAIL_PROVIDER=laravel_mail
NURSELINK_SMS_PROVIDER=unconfigured
NURSELINK_PUSH_PROVIDER=unconfigured
NURSELINK_WHATSAPP_PROVIDER=unconfigured
NURSELINK_CAMPAIGN_BATCH_SIZE=100
NURSELINK_ORG_CURRENCY=PHP

NURSELINK_RELEASE=1.0.0-cpanel-pilot.1
NURSELINK_ENVIRONMENT_LABEL=cpanel-pilot
NURSELINK_ANALYTICS_CACHE_SECONDS=300
NURSELINK_ANALYTICS_SNAPSHOT_RETENTION_DAYS=730
NURSELINK_ANALYTICS_MINIMUM_GROUP_SIZE=5
NURSELINK_REPORT_EXPORT_DISK=private
NURSELINK_REPORT_EXPORT_RETENTION_DAYS=14
NURSELINK_PRIVACY_EXPORT_DISK=private
NURSELINK_PRIVACY_EXPORT_RETENTION_DAYS=7
NURSELINK_PRIVACY_REQUEST_TARGET_DAYS=15
NURSELINK_TARGET_RPO_MINUTES=1440
NURSELINK_TARGET_RTO_MINUTES=240
NURSELINK_BACKUP_MANIFEST_DISK=private
NURSELINK_BACKUP_ROOT=/home/DEPLOY_USER/nurselink-backups
# For nginx, point this to the deployed server configuration or managed policy file.
NURSELINK_SECURITY_HEADERS_POLICY_PATH=/home/DEPLOY_USER/nurselink-security-headers.conf
NURSELINK_SECURITY_HEADERS_POLICY_MARKER=NURSELINK_SECURITY_HEADERS_V330_START
NURSELINK_AUDIT_RETENTION_DAYS=2555
